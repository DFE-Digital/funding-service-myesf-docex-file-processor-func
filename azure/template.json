{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "resourceEnvironmentName": {
            "type": "string",
            "metadata": {
                "description": "Short name of the environment. Used for the name of resources created."
            }
        },
        "serviceName": {
            "type": "string",
            "metadata": {
                "description": "Short name of the service. Used for the name of resources created."
            }
        },
        "aspSize": {
            "type": "string",
            "defaultValue": "1"
        },
        "aspInstances": {
            "type": "int",
            "defaultValue": 1
        },
        "aspTier": {
            "type": "string",
            "defaultValue": "Basic"
        },
        "sharedResourceGroupName": {
            "type": "string"
        },
        "sharedAppInsightsName": {
            "type": "string"
        },
        "sharedServiceBusName": {
            "type": "string"
        },
        "servicebusAccessKeyName": {
            "type": "string",
            "defaultValue": "RootManagedAccessKey"
        },
        "sharedStorageAccountName": {
            "type": "string"
        },
        "docExApiBaseAddress": {
            "type": "string"
        },
        "docExApiClientId": {
            "type": "string"
        },        
        "docExApiAppUri": {
            "type": "string"
        },
        "sharedKeyVaultName": {
			"type": "string",
			"metadata": {
				"description": "The name of the key vault where the secrets are stored"
			}
		}
    },
    "variables": {
        "deploymentUrlBase": "https://raw.githubusercontent.com/SkillsFundingAgency/funding-platform-building-blocks/master/templates/",
        "resourceNamePrefix": "[toLower(concat('pds-', parameters('resourceEnvironmentName'),'-', parameters('serviceName')))]",
        "functionAppName": "[concat(variables('resourceNamePrefix'), 'wkr-fa')]",
        "appServicePlanName": "[concat(variables('resourceNamePrefix'), 'wkr-asp')]"
    },
    "resources": [
        {
            "apiVersion": "2017-05-10",
            "name": "app-service-plan",
            "type": "Microsoft.Resources/deployments",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[concat(variables('deploymentUrlBase'),'app-service-plan.json')]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "appServicePlanName": {
                        "value": "[variables('appServicePlanName')]"
                    },
                    "aspSize": {
                        "value": "[parameters('aspSize')]"
                    },
                    "aspInstances": {
                        "value": "[parameters('aspInstances')]"
                    },
                    "nonASETier": {
                        "value": "[parameters('aspTier')]"
                    }
                }
            }
        },
        {
            "apiVersion": "2017-05-10",
            "name": "function-app",
            "type": "Microsoft.Resources/deployments",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[concat(variables('deploymentUrlBase'),'function-app.json')]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "functionAppName": {
                        "value": "[variables('functionAppName')]"
                    },
                    "appServicePlanName": {
                        "value": "[variables('appServicePlanName')]"
                    },
                    "appServicePlanResourceGroup": {
                        "value": "[resourceGroup().name]"
                    },
                    "functionAppAppSettings": {
                        "value": [
                            {
                                "name": "AzureWebJobsStorage",
                                "value": "[concat('DefaultEndpointsProtocol=https;AccountName=',parameters('sharedStorageAccountName'),';AccountKey=',listKeys(resourceId(parameters('sharedResourceGroupName'),'Microsoft.Storage/storageAccounts',parameters('sharedStorageAccountName')), providers('Microsoft.Storage', 'storageAccounts').apiVersions[0]).keys[0].value, ';EndpointSuffix=core.windows.net')]"
                            },
                            {
                                "name": "FUNCTIONS_EXTENSION_VERSION",
                                "value": "~4"
                            },
                            {
							                  "name": "FUNCTIONS_WORKER_RUNTIME",
							                  "value": "dotnet-isolated"
							              },
                            {
                                "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
                                "value": "[reference(resourceId(parameters('sharedResourceGroupName'), 'microsoft.insights/components', parameters('sharedAppInsightsName')),'2015-05-01').InstrumentationKey]"
                            },
                            {
                                "name": "PdsApplicationInsights:InstrumentationKey",
                                "value": "[reference(resourceId(parameters('sharedResourceGroupName'), 'microsoft.insights/components', parameters('sharedAppInsightsName')),'2015-05-01').InstrumentationKey]"
                            },
                            {
                                "name": "PdsApplicationInsights:Environment",
                                "value": "[parameters('resourceEnvironmentName')]"
                            },
                            {
                                "name": "ServiceBusConnection",
                                "value": "[concat('Endpoint=sb://', parameters('sharedServiceBusName'), '.servicebus.windows.net/;SharedAccessKeyName=', parameters('serviceBusAccessKeyName'), ';SharedAccessKey=',listKeys(resourceId(parameters('sharedResourceGroupName'),'Microsoft.ServiceBus/namespaces/AuthorizationRules',parameters('sharedServiceBusName'), parameters('serviceBusAccessKeyName')),'2015-08-01').primaryConnectionString)]"
                            },
                            {
                                "name": "DocumentExchangeFileProcessorServicesConfiguration:ApiBaseAddress",
                                "value": "[parameters('docExApiBaseAddress')]"
                            },
                            {
                                "name": "DocumentExchangeFileProcessorServicesConfiguration:Authority",
                                "value": "https://login.microsoftonline.com/"
                            },
                            {
                                "name": "DocumentExchangeFileProcessorServicesConfiguration:ClientId",
                                "value": "[parameters('docExApiClientId')]"
                            },
                            {
                                "name": "DocumentExchangeFileProcessorServicesConfiguration:TenantId",
                                "value": "[subscription().tenantId]"
                            },
                            {
                                "name": "DocumentExchangeFileProcessorServicesConfiguration:ClientSecret",
                                "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('sharedKeyVaultName'), ';SecretName=DocexdataApiClientSecret)')]"
							
                            },
                            {
                                "name": "DocumentExchangeFileProcessorServicesConfiguration:AppUri",
                                "value": "[parameters('docExApiAppUri')]"
                            }
                        ]
                    }
                }
            },
            "dependsOn": [
                "app-service-plan"
            ]
        }
    ],
    "outputs": {
        "FunctionAppName": {
            "type": "string",
            "value": "[variables('functionAppName')]"
        }
    }
}
